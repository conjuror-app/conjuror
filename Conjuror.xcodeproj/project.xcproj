  "targets": [
    {
      "name": "Conjuror",
      "id": "8A4E32402C55C00100C0A001",
      "product": "Products/Conjuror.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ARCHS[config=Release]": "arm64",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "Conjuror",
        "CODE_SIGN_ENTITLEMENTS": "Conjuror/Resources/Conjuror.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "16",
        "DEVELOPMENT_TEAM": "Y54Z78V9M7",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "Conjuror uses Shortcuts Events to list and run your Apple Shortcuts.",
        "INFOPLIST_KEY_NSDesktopFolderUsageDescription": "Conjuror searches file and folder names on your Desktop.",
        "INFOPLIST_KEY_NSDocumentsFolderUsageDescription": "Conjuror searches file and folder names in Documents.",
        "INFOPLIST_KEY_NSDownloadsFolderUsageDescription": "Conjuror searches file and folder names in Downloads.",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Debug]": "dev.tombell.conjuror.dev",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Release]": "dev.tombell.conjuror",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "ConjurorTests",
      "id": "8A4E33412C55C00100C0A001",
      "product": "Products/ConjurorTests.xctest",
      "product-type": "bundle.unit-test",
      "dependencies": [
        "Conjuror",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "Y54Z78V9M7",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.tombell.conjuror.tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Conjuror.app/Contents/MacOS/Conjuror",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
